  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Reed's Chase es una historia sobre bullying, cyberbullying, isolaci\xF3n
    y suicidio. Estos temas est\xE1n impl\xEDcitos, pero el juego puede seguir siendo
    molesto. Si estos temas son complicados para ti en estos momentos, est\xE1 bien
    cerrarlo y jugarlo en otro momento. Tu seguridad importa mucho m\xE1s que terminar
    la historia. Si tu o alguien que conozcas est\xE1 pasando por una situaci\xF3n
    complicada, recuerda que no estas solo/sola. En Espa\xF1a puedes llamar al 024.
    En los Estados Unidos puedess llamar o escribir al 988. Por otro lado findahelpline.com
    enumera l\xEDneas gratuitas de cada pa\xEDs. Si te encuentras en peligro inmediato,
    contacta a tu numero de emergencia local.\r\n\r\nAtentamente y con todo el cari\xF1o
    del mundo, esperemos que disfruten de la experiencia.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7725a1efdb6173f4cbf87c60682273f7, type: 2}
  m_sharedMaterial: {fileID: -6012754339816842123, guid: 7725a1efdb6173f4cbf87c60682273f7, type: 2}
